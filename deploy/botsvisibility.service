[Unit]
Description=botsvisibility.com (Next.js standalone)
After=network.target

[Service]
Type=simple
User=botsvis
Group=botsvis
WorkingDirectory=/var/www/botsvisibility/.next/standalone
Environment=NODE_ENV=production
Environment=PORT=3100
Environment=HOSTNAME=127.0.0.1
ExecStart=/usr/local/bin/node server.js
Restart=always
RestartSec=3
MemoryMax=400M
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/botsvisibility/.next
PrivateTmp=true

[Install]
WantedBy=multi-user.target
